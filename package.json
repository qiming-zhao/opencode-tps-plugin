{
  "name": "opencode-tps-plugin",
  "version": "0.1.0",
  "description": "Real-time AI generation speed and token throughput monitor for OpenCode",
  "author": "qiming-zhao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiming-zhao/opencode-tps-plugin.git"
  },
  "homepage": "https://github.com/qiming-zhao/opencode-tps-plugin#readme",
  "bugs": {
    "url": "https://github.com/qiming-zhao/opencode-tps-plugin/issues"
  },
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.13",
    "@opentui/core": "^0.3.0",
    "@opentui/solid": "^0.3.0",
    "solid-js": "1.9.12",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.13",
    "@opentui/solid": "*",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "ai",
    "tokens",
    "tps",
    "throughput",
    "monitor",
    "tokens-per-second",
    "solidjs"
  ],
  "license": "MIT"
}
